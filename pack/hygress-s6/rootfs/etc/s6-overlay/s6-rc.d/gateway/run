#!/command/with-contenv /bin/bash
# The Higress 'gateway' (envoy) s6 slot is repurposed as the Hygress data plane.
# This service IS in GPUStack's enabled gateway_services list, so prepare_s6_overlay
# will run it — no new s6 service needed.
# The hygress binary itself does the bounded GPUSTACK_API_PORT readiness probe
# (30 s, fail-fast) and binds the data plane only after its first CRD snapshot
# (ready() gate), satisfying the s6 "gateway waits for GPUStack API" contract.
SCRIPT_ROOT=/etc/s6-overlay/scripts
# shellcheck source=/dev/null
source "$SCRIPT_ROOT/base.sh"
# shellcheck disable=SC1090
source "$GPUSTACK_GATEWAY_CONFIG"
# shellcheck source=/dev/null
source "$SCRIPT_ROOT/default-variables.sh"

export HYGRESS_KUBECONFIG="${HYGRESS_KUBECONFIG:-${EMBEDDED_KUBECONFIG_PATH:-/var/lib/gpustack/higress/kubeconfig}}"
# R-13 (env alignment): the binary reads KUBECONFIG (or the file fallback);
# mirror the launcher's kubeconfig so both names agree.
export KUBECONFIG="${KUBECONFIG:-${HYGRESS_KUBECONFIG}}"
export GATEWAY_HTTP_PORT="${GATEWAY_HTTP_PORT:-80}"
export GATEWAY_HTTPS_PORT="${GATEWAY_HTTPS_PORT:-443}"
# R-13 (env alignment): the binary reads GATEWAY_TLS_PORT; accept the
# GPUStack-side GATEWAY_HTTPS_PORT name as its source.
export GATEWAY_TLS_PORT="${GATEWAY_TLS_PORT:-${GATEWAY_HTTPS_PORT:-443}}"
export GPUSTACK_API_PORT="${GPUSTACK_API_PORT:-30080}"
export HYGRESS_DATA_DIR="${HYGRESS_DATA_DIR:-/var/lib/gpustack}"
# The Rust bootstrap resolves the jwt_secret_key (design §9) from GPUSTACK_DATA_DIR;
# default-variables.sh sets DATA_DIR=/var/lib/gpustack — export it under the name the
# binary reads so `{data_dir}/jwt_secret_key` resolves (missing it = fail-fast exit).
export GPUSTACK_DATA_DIR="${GPUSTACK_DATA_DIR:-${DATA_DIR:-/var/lib/gpustack}}"
export GATEWAY_NAMESPACE="${GATEWAY_NAMESPACE:-higress-system}"
export HYGRESS_ADMIN_ADDR="${HYGRESS_ADMIN_ADDR:-127.0.0.1:8081}"
export GATEWAY_PILOT_AGENT_METRICS_PORT="${GATEWAY_PILOT_AGENT_METRICS_PORT:-15020}"
# Slow-starting containers (GPUStack re-boots + runs the gateway init on boot) can take
# longer than the default 30s/60s bounds; widen to align with GPUStack's 600s readiness
# window so a slow-but-healthy boot does not trip hygress's fail-fast (design §11.2).
export HYGRESS_API_READY_TIMEOUT="${HYGRESS_API_READY_TIMEOUT:-300}"
export HYGRESS_SNAPSHOT_TIMEOUT="${HYGRESS_SNAPSHOT_TIMEOUT:-300}"
export HYGRESS_POLICY_PATH="${HYGRESS_POLICY_PATH:-/etc/hygress/policy.yaml}"
# R-12: ext-auth failure mode (closed = reject when /token-auth unavailable/5xx,
# matching the GPUStack/Higress baseline; open = legacy fail-open).
export HYGRESS_EXT_AUTH_FAIL_MODE="${HYGRESS_EXT_AUTH_FAIL_MODE:-closed}"

# honor the original access.log logrotate tooling + keep hygress's own output in a
# host-visible file (under the GPUStack data bind volume) for diagnosis.
ACCESS_LOG_PATH="${HIGRESS_LOG_DIR:-/var/log/higress}/access.log"
HYGRESS_DATA_DIR="${HYGRESS_DATA_DIR:-/var/lib/gpustack}"
createDir "${HIGRESS_LOG_DIR:-/var/log/higress}"
mkdir -p "${HYGRESS_DATA_DIR}/log" 2>/dev/null || true
touch "${ACCESS_LOG_PATH}" 2>/dev/null || true

set -e
exec 2>&1

exec /usr/local/bin/hygress >>"${HYGRESS_DATA_DIR}/log/hygress.log" 2>&1
