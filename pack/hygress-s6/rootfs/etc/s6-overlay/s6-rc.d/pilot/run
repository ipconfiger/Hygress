#!/command/with-contenv /bin/bash
# no-op for the Higress Pilot that is being replaced by Hygress (gateway slot).
# Signals s6 readiness via notification-fd 3 (this service is `notification-fd: 3`
# and `gateway` depends on it — without the notification the s6-rc `change top`
# transition never settles and the main gpustack process never starts).
# LONG-SLEEP, NOT exit 0: s6-supervise would restart-loop a fast-exiting longrun.
echo "hygress: Higress 'pilot' disabled (replaced by hygress data plane)." >&2

if [ -e /etc/s6-overlay/scripts/base.sh ]; then
  # shellcheck source=/dev/null
  . /etc/s6-overlay/scripts/base.sh
fi

# s6 readiness notification (newline on notification-fd 3)
: >&3 2>/dev/null || true
printf '\n' >&3 2>/dev/null || true

exec sleep infinity
